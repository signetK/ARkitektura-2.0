<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.Ccis">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/arrow_header" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#D9D9D9">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:layout_marginBottom="170dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/collegeLogo"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_marginEnd="12dp"
                                android:src="@drawable/ic_ccis" />

                            <TextView
                                android:id="@+id/collegeTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="false"
                                android:scrollHorizontally="false"
                                android:gravity="center"
                                android:text="@string/ccis_name"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/black"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="20dp">

                            <Button
                                android:id="@+id/previewBtn"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:drawableLeft="@drawable/hollow_24"
                                android:drawablePadding="8dp"
                                android:text="3D Model"
                                android:backgroundTint="@color/lighter"
                                android:textColor="@color/white"
                                android:layout_marginEnd="8dp"/>

                            <Button
                                android:id="@+id/facultyBtn"
                                android:layout_width="0dp"
                                android:layout_height="45dp"
                                android:layout_weight="1"
                                android:drawableLeft="@drawable/baseline_people_24"
                                android:drawableTint="@color/white"
                                android:drawablePadding="8dp"
                                android:text="Faculty"
                                android:backgroundTint="@color/lighter"
                                android:textColor="@color/white"
                                android:layout_marginStart="8dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="History :"
                                android:textStyle="bold"
                                android:textColor="@color/black"/>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1"/> <!-- pushes speaker to the right -->

                            <ImageView
                                android:id="@+id/speakerHistory"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_speaker"
                                app:tint="@color/dark_gray"
                                android:clickable="true"
                                android:focusable="true"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/black"
                            android:layout_marginVertical="4dp" />

                        <TextView
                            android:id="@+id/collegeHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ccis_history"
                            android:layout_marginBottom="12dp"
                            android:textColor="@color/black"
                            android:justificationMode="inter_word"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Additional Info :"
                                android:textStyle="bold"
                                android:textColor="@color/black"/>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1"/> <!-- pushes speaker to the right -->

                            <ImageView
                                android:id="@+id/speakerInfo"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_speaker"
                                app:tint="@color/dark_gray"
                                android:clickable="true"
                                android:focusable="true"/>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/black"
                            android:layout_marginVertical="4dp" />

                        <TextView
                            android:id="@+id/collegeInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ccis_info"
                            android:layout_marginBottom="12dp"
                            android:textColor="@color/black"
                            android:justificationMode="inter_word"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Departments :"
                                android:textStyle="bold"
                                android:textColor="@color/black"/>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1"/> <!-- pushes speaker to the right -->

                            <ImageView
                                android:id="@+id/speakerDept"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_speaker"
                                android:clickable="true"
                                android:focusable="true"
                                app:tint="@color/dark_gray" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/black"
                            android:layout_marginVertical="4dp" />

                        <TextView
                            android:id="@+id/department"
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ccis_department"
                            android:paddingTop="6dp"
                            android:textColor="@color/black"/>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@drawable/baseline_chat_24"
        app:backgroundTint="@color/lighter"
        app:tint="@color/white"
        android:elevation="16dp"
        android:contentDescription="Feedback" />

</FrameLayout>
